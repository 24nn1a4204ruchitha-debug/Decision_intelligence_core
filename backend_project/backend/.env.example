# Application Configuration
APP_NAME=Adaptive Decision Intelligence Platform
APP_ENV=development
DEBUG=True
API_V1_STR=/api
SECRET_KEY=antigravity-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite if Postgres is not running)
# PostgreSQL Example: postgresql://postgres:postgres@localhost:5432/decision_system
# SQLite Example: sqlite:///./decision_system.db
DATABASE_URL=sqlite:///./decision_system.db

# CORS Configuration
BACKEND_CORS_ORIGINS=["*"]

# Anomaly Detection & Decision Thresholds
ANOMALY_CONTAMINATION=0.1
CONFIDENCE_THRESHOLD_AUTONOMOUS=0.75
CONFIDENCE_THRESHOLD_ESCALATION=0.50
HIGH_RISK_CONFIDENCE_MIN=0.85

# Optional Pluggable LLM Integration (OpenAI / Gemini / Anthropic / Ollama)
# If left blank, the system automatically uses the robust deterministic XAI explanation engine
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Demo Simulation Configuration
SIMULATION_INTERVAL_SECONDS=4
SIMULATION_AUTO_START=False
